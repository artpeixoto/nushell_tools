// prog = {SOI ~ (cmd ~ (nl ~ cmd)*) ~ EOI}
main =
    { SOI
    ~ cmd_name
    ~ ( cmd_abbr )?
    ~ ( multi_flags_parm | enum_flags_parm )?
    ~ (  kw_parm  ~ (space? ~ kw_parm)*)?
    ~ (  pos_parms )?
    ~ space?
    ~ EOI
    }

cmd_name = { ident }
cmd_abbr = { "(" ~ ident ~ ")" }


multi_flags_parm = {  "[" ~  multi_flags ~ "]" }
multi_flags = @{"-" ~ flag_name ~ (flag_name)*}
flag_name = {alphanum}
flag     = @{ "-" ~ flag_name }
enum_flags_parm = {  "[" ~ flag ~ ( "|" ~ ( flag ) )+ ~ "]" }
parm_pat = @{ parm_name ~ ( ":" ~ parm_name )+ }
kw_parm = { "[" ~ flag ~ space ~ ( parm_pat|parm_name ) ~ "]"}
parm_name = {ident}

pos_parms =
    !{ ( pos_opt_parm )*
    ~ ( space? ~ !final_parm ~ pos_req_parm )*
    ~ ( space? ~ final_parm )?
    }

final_parm = { rest_parm |  cmd_parm }
rest_parm = { "..." }

pos_parm = { pos_req_parm | pos_opt_parm }
pos_req_parm = {pos_parm_pat}
pos_opt_parm = { "[" ~ pos_parm_pat ~ "]" }
pos_parm_pat = {ident}


cmd_parm = { cmd_parm_pat | ( "[" ~ cmd_parm_pat ~ "]" )}
cmd_parm_pat =  { cmd_name ~ ( pos_parm )* }

nl = _{ NEWLINE }
space    = @{" "+}
letter   = _{ ASCII_ALPHA }
digit    = _{ ASCII_DIGIT }
alphanum = _{ letter | digit }
word     = @{ letter+ }
ident    = @{ !digit ~ (digit | word | "-" | "_")+ }
// send-keys (send) [-FHKlMRX] [-c target-client] [-N repeat-count] [-t target-pane] key ...
// display-menu (menu) [-O] [-b border-lines] [-c target-client] [-C starting-choice] [-H selected-style] [-s style] [-S border-style] [-t target-pane][-T title] [-x position] [-y position] name key command ...

WHITESPACE = {" " | "\t"}
