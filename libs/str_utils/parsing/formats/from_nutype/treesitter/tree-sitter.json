{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sample_grammar",
      "camelcase": "n",
      "title": "SampleGrammar",
      "scope": "source.sample_grammar",
      "file-types": [
        "sample_grammar"
      ],
      "injection-regex": "^sample_grammar$",
      "class-name": "TreeSitterSampleGrammar"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "SampleGrammar grammar for tree-sitter",
    "authors": [
      {
        "name": "ass-eater",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-sample_grammar",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}