{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "sample_grammar",
  "rules": {
    "source_file": {
      "type": "SYMBOL",
      "name": "type"
    },
    "type": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "composed_type"
        },
        {
          "type": "SYMBOL",
          "name": "value_type"
        }
      ]
    },
    "composed_type": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "list_type"
        },
        {
          "type": "SYMBOL",
          "name": "oneof_type"
        },
        {
          "type": "SYMBOL",
          "name": "record_type"
        }
      ]
    },
    "list_type": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "list"
        },
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "SYMBOL",
          "name": "type"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "oneof_type": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "oneof"
        },
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "SYMBOL",
          "name": "type"
        },
        {
          "type": "SYMBOL",
          "name": "type"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "record_type": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "record"
        },
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "field_defn"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": ","
                  },
                  {
                    "type": "SYMBOL",
                    "name": "field_defn"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "table_type": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "table"
        },
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "field_defn"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": ","
                  },
                  {
                    "type": "SYMBOL",
                    "name": "field_defn"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "field_defn": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "field_name"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "SYMBOL",
          "name": "type"
        }
      ]
    },
    "field_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "type": "PATTERN",
          "value": "\\\"(.)+\\\""
        }
      ]
    },
    "value_type": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "bool"
        },
        {
          "type": "STRING",
          "value": "path"
        },
        {
          "type": "STRING",
          "value": "string"
        },
        {
          "type": "STRING",
          "value": "int"
        },
        {
          "type": "STRING",
          "value": "nothing"
        },
        {
          "type": "STRING",
          "value": "float"
        },
        {
          "type": "STRING",
          "value": "binary"
        },
        {
          "type": "STRING",
          "value": "duration"
        },
        {
          "type": "STRING",
          "value": "datetime"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s*"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}